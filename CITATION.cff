version: 2.0.0
date-released: 2026-11-15
license: MIT
repository-code: "https://github.com/Celivem/Electromagnetics-Visualization-Hub"
url: "https://github.com/Celivem/Electromagnetics-Visualization-Hub"
keywords:
  - electromagnetics
  - physics education
  - Streamlit
  - Laplace equation
  - Fourier series
  - Legendre polynomials
  - visualization
